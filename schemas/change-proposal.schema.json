{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "from_version": {
      "type": "string",
      "minLength": 1
    },
    "to_version": {
      "type": "string",
      "minLength": 1
    },
    "upstream_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "profile_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rollback_version": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "enum": [
        "public",
        "private"
      ]
    },
    "review_state": {
      "enum": [
        "draft",
        "approved"
      ]
    }
  },
  "required": [
    "id",
    "workflow_id",
    "from_version",
    "to_version",
    "upstream_ref",
    "reason",
    "changes",
    "risk",
    "evaluation_ids",
    "profile_scope",
    "rollback_version",
    "owner",
    "visibility",
    "review_state"
  ]
}
