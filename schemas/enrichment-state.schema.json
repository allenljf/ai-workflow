{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batches",
    "monthly_ledger",
    "next_ai_due_at",
    "max_batch_usd",
    "max_monthly_usd",
    "interval_days"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "interval_days": {
      "const": 14
    },
    "next_ai_due_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "batches": {
      "type": "object"
    },
    "monthly_ledger": {
      "type": "object"
    },
    "max_batch_usd": {
      "type": "string"
    },
    "max_monthly_usd": {
      "type": "string"
    }
  }
}
