{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workflow_id",
    "workflow_version",
    "task_id",
    "spec_hash",
    "base_sha",
    "head_sha",
    "model_version",
    "harness_version",
    "environment",
    "commands",
    "acceptance_results",
    "artifact_refs",
    "provenance",
    "executed",
    "failed",
    "skipped",
    "cost",
    "human_minutes",
    "duration"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "harness_version": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv",
          "exit_code"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "acceptance_results": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "provenance": {
      "enum": [
        "real",
        "synthetic"
      ]
    },
    "executed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "failed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "skipped": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cost": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "human_minutes": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "duration": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  }
}
