---
import Layout from '../layouts/Layout.astro';
import {href,date} from '../lib/data';
import json from '../generated/digests.json';
interface Digest {title:string;path:string;model:string;enriched_at:string;reviewed_at:string;demo:boolean}
const digests=json as Digest[];
---
<Layout title="雙週精選"><section class="updates"><p class="eyebrow">REVIEWED KNOWLEDGE</p><h1>雙週精選</h1><p class="hero-copy">AI 整理先成為草稿，人工審閱後才在這裡發布。引用可追溯，不代表推論已經通過 Android 實測。</p>{digests.length===0?<p class="empty">尚無人工核准的精選</p>:digests.map(d=><article class="event-card"><h2><a href={href('guides/'+d.path.replace(/\.md$/,''))}>{d.title}</a></h2><p>整理：{date(d.enriched_at)} · 人工核准：{date(d.reviewed_at)}</p><p>{d.demo?'合成示範 · 不是真實成功案例':'模型：'+d.model}</p><a href={href('guides/'+d.path.replace(/\.md$/,''))}>閱讀 Markdown ↗</a></article>)}</section></Layout>
