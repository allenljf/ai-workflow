{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batches",
    "monthly_ledger",
    "next_ai_due_at",
    "max_batch_usd",
    "max_monthly_usd",
    "interval_days"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "interval_days": {
      "const": 14
    },
    "next_ai_due_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "batches": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "input_hash",
          "event_ids",
          "status",
          "reserved_usd",
          "actual_usd",
          "result_hash",
          "review_pr_url",
          "reservation_month",
          "result",
          "request",
          "completed_at",
          "diagnostic",
          "usage"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "input_hash": {
            "type": "string"
          },
          "event_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "reserved_usd": {
            "type": "string"
          },
          "actual_usd": {
            "type": [
              "string",
              "null"
            ]
          },
          "result_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_pr_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "reservation_month": {
            "type": [
              "string",
              "null"
            ]
          },
          "charged_month": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "type": [
              "object",
              "null"
            ]
          },
          "request": {
            "type": [
              "object",
              "null"
            ]
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "diagnostic": {
            "type": [
              "string",
              "null"
            ]
          },
          "usage": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "monthly_ledger": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actual_usd"
        ],
        "properties": {
          "actual_usd": {
            "type": "string"
          }
        }
      }
    },
    "max_batch_usd": {
      "type": "string"
    },
    "max_monthly_usd": {
      "type": "string"
    }
  }
}
