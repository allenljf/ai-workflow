{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stories"
  ],
  "properties": {
    "stories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "why",
          "usage",
          "limitations",
          "case_evidence",
          "source_ids",
          "claim_evidence"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "maxLength": 2000
          },
          "usage": {
            "type": "string",
            "maxLength": 2000
          },
          "limitations": {
            "type": "string",
            "maxLength": 2000
          },
          "case_evidence": {
            "enum": [
              "author_claim",
              "vendor_case",
              "reproducible",
              "internal_evaluation",
              "unknown"
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "claim_evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claim",
                "kind",
                "source_id",
                "quote"
              ],
              "properties": {
                "claim": {
                  "type": "string",
                  "maxLength": 2000
                },
                "kind": {
                  "enum": [
                    "source",
                    "inference"
                  ]
                },
                "source_id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string",
                  "maxLength": 2000
                }
              }
            }
          }
        }
      }
    },
    "landscape_updates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_heading",
          "replacement",
          "why",
          "source_ids",
          "quote"
        ],
        "properties": {
          "section_heading": {
            "type": "string",
            "maxLength": 180
          },
          "replacement": {
            "type": "string",
            "maxLength": 10000
          },
          "why": {
            "type": "string",
            "maxLength": 1500
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          },
          "quote": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  }
}
